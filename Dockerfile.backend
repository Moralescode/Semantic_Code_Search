# Dockerfile pour le Backend FastAPI CodeMind
FROM python:3.11-slim

WORKDIR /app

# Installation des dépendances système de base (librairies FAISS requis)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libopenblas-dev \
    libomp-dev \
    && rm -rf /var/lib/apt/lists/*

# Installation de PyTorch CPU en premier (évite de télécharger les versions CUDA massives de >500MB)
RUN pip install --no-cache-dir torch --extra-index-url https://download.pytorch.org/whl/cpu

# Copie des fichiers de dépendances et installation du reste
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Exposition du port FastAPI
EXPOSE 8000

# Commande de démarrage
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
